NEXT_PUBLIC_SITE_URL=http://localhost:3030
# Storefronts API (shielva-storefronts-api). Browser calls go through the /api/v1 rewrite, so cookies stay first-party.
API_ORIGIN=http://127.0.0.1:8040
# Shared with the API so it can refresh pages after admin edits.
REVALIDATE_SECRET=
# Admin console + in-place editor are served ONLY on these hosts (prod: storefront-admin.shielva.ai).
ADMIN_HOSTS=admin.localhost:3030
# Brand domains serve their store at the root (prod: velour.shielva.ai=beauty,maisonnoor.shielva.ai=salon,ateliernord.shielva.ai=fashion).
BRAND_HOSTS=velour.localhost:3030=beauty,maisonnoor.localhost:3030=salon,ateliernord.localhost:3030=fashion
